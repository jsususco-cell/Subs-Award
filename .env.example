# Quickbase connection for the Job / Subcontractor lookups.
# Copy to .env.local for local dev. .env* is gitignored — never commit a token.
#
# IMPORTANT: /api/qb is only as private as the deployment. Turn on Vercel
# Deployment Protection BEFORE setting QB_USER_TOKEN in Production, or the
# job and vendor lists are readable by anyone with the URL.

QB_USER_TOKEN=
QB_REALM=byrdsonservices.quickbase.com

# Region the lookups filter to.
QB_REGION=Puerto Rico

# Tables (defaults shown).
QB_JOBS_TABLE=buskqh27b
QB_VENDORS_TABLE=buskqh272

# Field ids that are not yet confirmed. Leave blank until you have them:
#   npm run qb:introspect          -> find the Jobs address field
#   npm run qb:add-vendor-region   -> create + report the Vendors Region field
QB_JOB_ADDRESS_FID=
QB_VENDOR_REGION_FID=

# ---------------------------------------------------------------------------
# Award letter email — pick ONE transport. Checked in this order.
# ---------------------------------------------------------------------------

# 1. n8n (preferred). No mail credential lives in this app; n8n holds it and
#    its execution log is the send audit trail. Import n8n/send-award-letter.json.
#    The webhook can send mail as the company, so it MUST require the token.
N8N_SEND_WEBHOOK_URL=
N8N_WEBHOOK_TOKEN=

# 2. Google service account with domain-wide delegation. A Workspace
#    super-admin must authorise its client ID for https://mail.google.com/
#    (SMTP will not accept a send-only scope). GMAIL_USER is the mailbox it
#    impersonates. Paste the JSON key's private_key with 
 escapes intact.
GMAIL_SERVICE_ACCOUNT_EMAIL=
GMAIL_SERVICE_ACCOUNT_KEY=

# 3. Google App Password (simplest, but tied to one person's account).
# GMAIL_APP_PASSWORD must be a Google App Password, which requires 2FA on the
# account. A normal account password is rejected with 535-5.7.8.
GMAIL_USER=
GMAIL_APP_PASSWORD=
MAIL_FROM_NAME=Byrdson Services

# Shared secret the browser must present to send, same idea as the vendor
# portal's PORTAL_SEND_KEY. REQUIRED on Vercel: a hosted deployment is
# reachable by anyone, so without a key it refuses to send at all rather than
# acting as an open relay. Not needed for local development.
# QUOTE the value if it contains a # or spaces. Unquoted, dotenv treats # as
# the start of a comment and silently truncates the value there, so the key
# the app checks would differ from the one you set in Vercel.
LETTER_SEND_KEY=

# Rollout safety rail. While this is set, ONLY these addresses can be mailed;
# anything else is refused instead of delivered. Leave blank in normal use.
LETTER_SEND_ALLOWLIST=

# Vendor email field on the Subs/Vendors table (default 28).
QB_VENDOR_EMAIL_FID=

# Local PDF rendering uses installed Chrome; set this if it is not on the
# default path. On Vercel the bundled Linux Chromium is used instead.
CHROME_PATH=

# Quickbase connection for the Job / Subcontractor lookups.
# Copy to .env.local for local dev. .env* is gitignored — never commit a token.
#
# IMPORTANT: /api/qb is only as private as the deployment. Turn on Vercel
# Deployment Protection BEFORE setting QB_USER_TOKEN in Production, or the
# job and vendor lists are readable by anyone with the URL.

QB_USER_TOKEN=
QB_REALM=byrdsonservices.quickbase.com

# Region the lookups filter to.
QB_REGION=Puerto Rico

# Tables (defaults shown).
QB_JOBS_TABLE=buskqh27b
QB_VENDORS_TABLE=buskqh272

# Field ids that are not yet confirmed. Leave blank until you have them:
#   npm run qb:introspect          -> find the Jobs address field
#   npm run qb:add-vendor-region   -> create + report the Vendors Region field
QB_JOB_ADDRESS_FID=
QB_VENDOR_REGION_FID=

# ---------------------------------------------------------------------------
# Award letter email (Gmail SMTP via nodemailer)
# ---------------------------------------------------------------------------
# GMAIL_APP_PASSWORD must be a Google App Password, which requires 2FA on the
# account. A normal account password is rejected with 535-5.7.8.
GMAIL_USER=
GMAIL_APP_PASSWORD=
MAIL_FROM_NAME=Byrdson Services

# Rollout safety rail. While this is set, ONLY these addresses can be mailed;
# anything else is refused instead of delivered. Leave blank in normal use.
LETTER_SEND_ALLOWLIST=

# Vendor email field on the Subs/Vendors table (default 28).
QB_VENDOR_EMAIL_FID=

# Local PDF rendering uses installed Chrome; set this if it is not on the
# default path. On Vercel the bundled Linux Chromium is used instead.
CHROME_PATH=

{
  "name": "Subs Award — Send Award Letter",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "subs-award-send-letter",
        "authentication": "headerAuth",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "webhook",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        0
      ],
      "webhookId": "subs-award-send-letter",
      "credentials": {
        "httpHeaderAuth": {
          "id": "LpeDib7oMulYwdNz",
          "name": "Subs Award webhook token"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const out = [];\n\nfor (const item of $input.all()) {\n  const req = item.json.body ?? item.json;\n  const att = (req.attachments ?? [])[0];\n  if (!att) throw new Error('No attachment on the request');\n\n  const b64 = String(att.contentBase64 ?? '');\n  const name = att.filename ?? 'attachment.pdf';\n  const dot = name.lastIndexOf('.');\n\n  out.push({\n    json: {\n      to: (req.to ?? []).join(', '),\n      cc: (req.cc ?? []).join(', '),\n      subject: req.subject,\n      html: req.html,\n      fromName: req.fromName ?? 'Byrdson Services',\n    },\n    binary: {\n      attachment: {\n        data: b64,\n        mimeType: att.contentType ?? 'application/pdf',\n        fileName: name,\n        fileExtension: dot > -1 ? name.slice(dot + 1) : 'pdf',\n        fileSize: Buffer.byteLength(b64, 'base64'),\n      },\n    },\n  });\n}\n\nreturn out;"
      },
      "id": "decode",
      "name": "Decode attachment",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        0
      ]
    },
    {
      "parameters": {
        "sendTo": "={{ $json.to }}",
        "subject": "={{ $json.subject }}",
        "emailType": "html",
        "message": "={{ $json.html }}",
        "options": {
          "ccList": "={{ $json.cc }}",
          "senderName": "={{ $json.fromName }}",
          "attachmentsUi": {
            "attachmentsBinary": [
              {
                "property": "attachment"
              }
            ]
          }
        }
      },
      "id": "gmail",
      "name": "Send award letter",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [
        440,
        0
      ],
      "webhookId": "df9aac56-651a-4b95-961a-d7c24d22755f",
      "credentials": {
        "gmailOAuth2": {
          "id": "VFSVlQJu0WvJeCVE",
          "name": "Byrdson Admin Gmail account"
        }
      }
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ messageId: $json.id ?? 'sent', threadId: $json.threadId ?? null }) }}",
        "options": {}
      },
      "id": "respond",
      "name": "Respond",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        660,
        0
      ]
    }
  ],
  "connections": {
